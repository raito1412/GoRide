# Copy file này thành .env rồi điền giá trị (.env đã bị git ignore)

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=goride
DB_USER=goride
DB_PASSWORD=goride123
DB_ROOT_PASSWORD=root123

# ---------- Server socket ----------
# Máy chạy client khác máy server: đổi SERVER_HOST thành IP LAN của máy server (vd 192.168.1.10)
SERVER_HOST=127.0.0.1
TCP_PORT=6060
UDP_PORT=6061

# ---------- Goong REST API (https://account.goong.io) ----------
# Chỉ máy chạy SERVER cần key. Để trống: tìm địa chỉ bị tắt, quãng đường tính theo đường chim bay
MAPBOX_TOKEN=

# ---------- Nghiệp vụ ----------
MATCH_RADIUS_KM=5
DRIVER_SHARE=0.8
MAP_DEFAULT_LAT=10.7769
MAP_DEFAULT_LNG=106.7009

# ---------- Gmail gửi OTP xác thực đăng ký ----------
# Chỉ máy chạy SERVER cần. Để trống: server in mã OTP ra console thay vì gửi email (dùng khi dev).
# GMAIL_APP_PASSWORD là "mật khẩu ứng dụng" 16 ký tự: Google Account > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Tùy chọn: dùng access token OAuth2 thay cho app password
GMAIL_OAUTH_TOKEN=
# Tùy chọn: 465 = SSL (mặc định), 587 = STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM_NAME=GoRide

# ---------- Đối soát / hoá đơn tháng ----------
# Tài xế giữ DRIVER_SHARE (0.8 = nền tảng lấy 20%); quán giữ RESTAURANT_SHARE tiền món (0.75 = nền tảng lấy 25%)
RESTAURANT_SHARE=0.75
# Thuế khoán nền tảng khấu trừ thay (TT 40/2021/TT-BTC): GTGT 3% + TNCN 1,5% trên phần được hưởng.
# Miễn khi doanh thu được hưởng cả năm chưa vượt ngưỡng (Luật thuế GTGT 2024: 200 triệu). Đặt 0 để luôn tính thuế khi demo.
TAX_VAT_RATE=0.03
TAX_PIT_RATE=0.015
TAX_THRESHOLD_YEAR=200000000
# Chi trả vào ngày này của tháng kế tiếp
PAYOUT_DAY=10
