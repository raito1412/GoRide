# Copy file này thành .env rồi điền giá trị (.env đã bị git ignore)

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=goride
DB_USER=goride
DB_PASSWORD=goride123
DB_ROOT_PASSWORD=root123

# ---------- Server socket ----------
# Máy chạy client khác máy server: đổi SERVER_HOST thành IP LAN của máy server (vd 192.168.1.10)
SERVER_HOST=127.0.0.1
TCP_PORT=6060
UDP_PORT=6061

# ---------- Goong REST API (https://account.goong.io) ----------
# Chỉ máy chạy SERVER cần key. Để trống: tìm địa chỉ bị tắt, quãng đường tính theo đường chim bay
MAPBOX_TOKEN=

# ---------- Nghiệp vụ ----------
MATCH_RADIUS_KM=5
DRIVER_SHARE=0.8
MAP_DEFAULT_LAT=10.7769
MAP_DEFAULT_LNG=106.7009
